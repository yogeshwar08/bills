# Bill Snap Backend Configuration
# Obtain your Gemini API Key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Configurable Gemini Model (e.g., gemini-3.5-flash, gemini-2.5-flash, gemini-flash-lite-latest)
GEMINI_MODEL=gemini-3.5-flash

# Backend Host & Port
PORT=8000
HOST=0.0.0.0

